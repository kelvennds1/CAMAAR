<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Camaar" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Camaar">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="app-header">
      <div class="app-header__content">
        <span class="app-logo">CAMAAR</span>
        <nav class="app-nav">
          <% if current_user&.dicente? %>
            <%= link_to "Meus Formulários", formularios_pendentes_path, class: ["app-nav__link", ("app-nav__link--active" if action_name == "pendentes")].compact.join(" ") %>
          <% else %>
            <%= link_to "Templates", templates_path, class: ["app-nav__link", ("app-nav__link--active" if controller_name == "templates")].compact.join(" ") %>
            <%= link_to "Avaliações", avaliacoes_path, class: ["app-nav__link", ("app-nav__link--active" if controller_name == "avaliacoes" && action_name != "pendentes")].compact.join(" ") %>
            <%= link_to "Resultados", resultados_path, class: ["app-nav__link", ("app-nav__link--active" if controller_name == "resultados")].compact.join(" ") %>
            <%= link_to "Importação SIGAA", sigaa_imports_path, class: ["app-nav__link", ("app-nav__link--active" if controller_name == "sigaa_imports")].compact.join(" ") %>
          <% end %>
        </nav>
      </div>
    </header>

    <main class="app-main">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>
  </body>
</html>
